MONGODB_URI=your_mongodb_connection_string
MONGODB_DATABASE=your_database_name

# Server-only. Replace with your Google Gemini API key to enable AI assistant features.
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# Optional: Shared daily limit across all visitors. Requires MongoDB settings above.
PIP_DAILY_LIMIT=500

# Optional: A stable, random server-only secret for signed visitor cookies and IP hashing.
PIP_IDENTITY_SECRET=replace-with-a-random-secret
